{
  "name": "backend",
  "version": "1.0.0",
  "description": "CaReMind REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-development.js",
    "db:setup": "npm run db:migrate",
    "frontend:serve": "node scripts/serve-frontend.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check-syntax.js"
  },
  "keywords": [
    "vehicle-management",
    "maintenance",
    "express",
    "mysql"
  ],
  "author": "Panagiotis Eleftheriadis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panagiotiseleftheriadis/CaReMind.git"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "resend": "^6.19.0"
  }
}
