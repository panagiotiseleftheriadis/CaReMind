PORT=3000
NODE_ENV=development

# Neon pooled PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL=true
DB_POOL_MAX=5

# Optional one-time source connection for `npm run db:import:mysql`.
MYSQL_SOURCE_HOST=localhost
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASS=replace_with_source_database_password
MYSQL_SOURCE_NAME=caremind

# Use a long, random value. Never commit the real secret.
JWT_SECRET=replace_with_a_long_random_secret

RESEND_API_KEY=replace_with_resend_api_key
CRON_SECRET=replace_with_a_long_random_cron_secret

# Production defaults. Localhost cookies are configured automatically.
COOKIE_DOMAIN=.car-remind.gr

# Extra allowed frontend origins, separated by commas.
CORS_ORIGINS=

# Optional development-only administrator seed (npm run db:seed).
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
