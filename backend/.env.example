PORT=3000
NODE_ENV=development

# Application/runtime connection. Neon pooling is appropriate here.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL=true
DB_POOL_MAX=5

# Direct/non-pooler connection to the SAME database; required in production/CI.
# Migration TLS verifies certificates; DB_SSL controls only the runtime adapter.
MIGRATION_DATABASE_URL=postgresql://user:password@direct-host/database?sslmode=verify-full

# Integration tests read the shell environment ONLY, never this dotenv file.
# Disposable loopback database; role needs CREATEDB. Never use application data.
# TEST_DATABASE_URL=postgresql://caremind_test:disposable_password@127.0.0.1:5432/caremind_test?sslmode=disable

# Optional one-time source connection for `npm run db:import:mysql`.
MYSQL_SOURCE_HOST=localhost
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASS=replace_with_source_database_password
MYSQL_SOURCE_NAME=caremind

# Use a long, random value. Never commit the real secret.
JWT_SECRET=replace_with_a_long_random_secret

# Backend-only distributed security limiter. Required in production and on Vercel
# (including previews). Use a separate Redis database for preview/staging.
# Missing/partial configuration: protected POSTs return 503, never memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Independent random secret, >=32 characters; same value on all instances.
# HMACs account identifiers/IPs; rotating this resets current quotas.
RATE_LIMIT_KEY_SECRET=
# With no Redis config, local development uses bounded process-local memory.
# NODE_ENV=test ignores Redis credentials; tests use injected stores/fake HTTP.

RESEND_API_KEY=replace_with_resend_api_key
CRON_SECRET=replace_with_a_long_random_cron_secret

# Production defaults. Localhost cookies are configured automatically.
COOKIE_DOMAIN=.car-remind.gr

# Extra allowed frontend origins, separated by commas.
CORS_ORIGINS=

# P3a compatibility gate. Keep false until every deployed backend is archive-aware
# and the P3b UI replaces ordinary vehicle removal with archive/restore controls.
VEHICLE_ARCHIVE_ENABLED=false

# P4a capability gate. Keep false until the dated-history API and compatible UI
# are deployed. Baseline/cache compatibility remains active regardless.
ODOMETER_HISTORY_ENABLED=false

# Optional development-only administrator seed (npm run db:seed).
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
